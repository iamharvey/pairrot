# OpenAI-compatible chat endpoint. pairrot posts to ${PAIRROT_BASE_URL}/chat/completions.
# Existing environment variables take precedence over this file.
PAIRROT_BASE_URL=https://api.deepseek.com/v1
PAIRROT_API_KEY=
PAIRROT_MODEL=deepseek-v4-flash
# Optional. Defaults to PAIRROT_MODEL.
# PAIRROT_VERIFIER_MODEL=
